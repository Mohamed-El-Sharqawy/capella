# Backend Dockerfile - Bun + Elysia + Prisma
# Build and run from dist for production
FROM oven/bun:1
WORKDIR /app

RUN bun add -g pnpm@10

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/

RUN pnpm install --frozen-lockfile

COPY apps/backend ./apps/backend
COPY packages ./packages

WORKDIR /app/apps/backend
RUN pnpm exec prisma generate
RUN pnpm build

ENV NODE_ENV=production
ENV PORT=3001

ARG ZIINA_API_KEY
ARG ZIINA_WEBHOOK_SECRET
ARG ZIINA_WEBHOOK_URL
ARG ZIINA_TEST_MODE
ARG MAILTRAP_TOKEN
ARG META_PIXEL_ID
ARG META_ACCESS_TOKEN
ARG META_TEST_EVENT_CODE
ARG META_FEED_TOKEN
ARG META_FEED_BRAND
ARG MARKETING_URL
ARG TABBY_SECRET_KEY
ARG TABBY_MERCHANT_CODE
ARG TABBY_WEBHOOK_SECRET
ARG TABBY_API_BASE
ARG TAMARA_API_KEY
ARG TAMARA_API_BASE
ARG BACKEND_PUBLIC_URL
ENV ZIINA_API_KEY=${ZIINA_API_KEY}
ENV ZIINA_WEBHOOK_SECRET=${ZIINA_WEBHOOK_SECRET}
ENV ZIINA_WEBHOOK_URL=${ZIINA_WEBHOOK_URL}
ENV ZIINA_TEST_MODE=${ZIINA_TEST_MODE}
ENV MAILTRAP_TOKEN=${MAILTRAP_TOKEN}
ENV META_PIXEL_ID=${META_PIXEL_ID}
ENV META_ACCESS_TOKEN=${META_ACCESS_TOKEN}
ENV META_TEST_EVENT_CODE=${META_TEST_EVENT_CODE}
ENV META_FEED_TOKEN=${META_FEED_TOKEN}
ENV META_FEED_BRAND=${META_FEED_BRAND}
ENV MARKETING_URL=${MARKETING_URL}
ENV TABBY_SECRET_KEY=${TABBY_SECRET_KEY}
ENV TABBY_MERCHANT_CODE=${TABBY_MERCHANT_CODE}
ENV TABBY_WEBHOOK_SECRET=${TABBY_WEBHOOK_SECRET}
ENV TABBY_API_BASE=${TABBY_API_BASE}
ENV TAMARA_API_KEY=${TAMARA_API_KEY}
ENV TAMARA_API_BASE=${TAMARA_API_BASE}
ENV BACKEND_PUBLIC_URL=${BACKEND_PUBLIC_URL}

EXPOSE 3001

CMD ["sh", "-c", "pnpm exec prisma db push --accept-data-loss && bun run dist/index.js"]
