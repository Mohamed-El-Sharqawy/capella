enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(PENDING)
  total  Float

  // Shipping cost actually applied at checkout (AED). Snapshot at creation so
  // threshold changes don't retroactively alter what was charged. Read paths
  // (CMS, invoices, emails) must use this instead of recomputing.
  shippingAmount Float @default(0)

  // Payment fields
  paymentMethod         String?
  ziinaPaymentIntentId  String? @unique
  tabbyPaymentId        String? @unique
  tamaraCheckoutId      String? @unique
  paidAt                DateTime?

  // True while this order's units are deducted from variant stock. Set when
  // a COD order is placed or an online checkout session starts (the units are
  // held while the customer pays); cleared when the order is cancelled/
  // refunded or an unpaid online hold expires. Restocking keys off this flag,
  // never off status alone, so stock is returned exactly once. Legacy orders
  // (pre-flag) default to false and are never restocked automatically.
  stockReserved         Boolean @default(false)

  // Coupon applied to order
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  couponId String?
  discountAmount Float @default(0)

  // Authenticated user (nullable for guest orders)
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  // Guest info (populated when no user)
  guestEmail     String?
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?

  // Shipping address (snapshot at order time)
  address   Address? @relation(fields: [addressId], references: [id])
  addressId String?

  shippingFirstName String
  shippingLastName  String
  shippingStreet    String
  shippingCity      String
  shippingState     String
  shippingZipCode   String
  shippingCountry   String
  shippingPhone     String?

  note  String? @db.Text
  fbp   String?
  fbc   String?
  // Full browser context (fbp/fbc/IP/UA/eventSourceUrl) captured at checkout
  // creation. Rehydrated by `capiContextFromOrder` on webhook Purchase paths
  // where the PSP-sourced request carries none of the browser identity.
  capiContext Json?
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([status, stockReserved, createdAt])
  @@index([guestEmail])
  @@index([ziinaPaymentIntentId])
  @@index([tabbyPaymentId])
  @@index([tamaraCheckoutId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String

  // Snapshot at order time (denormalized for history)
  productNameEn String
  productNameAr String
  variantNameEn String
  variantNameAr String
  sku         String?
  quantity    Int
  price       Float
  imageUrl    String?

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}
