# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce"

# JWT
JWT_SECRET="your-jwt-secret-here"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Ziina
ZIINA_API_KEY="your-ziina-api-key"
ZIINA_WEBHOOK_SECRET="your-webhook-secret"

# Tabby (Buy Now, Pay Later)
# Secret key (sk_... live / sk_test_... sandbox) — routes to live/sandbox automatically
TABBY_SECRET_KEY="your_tabby_secret_key"
# Merchant code provided by Tabby (e.g. CUAE)
TABBY_MERCHANT_CODE="your_tabby_merchant_code"
# Optional: HMAC signing secret configured in the Tabby dashboard for webhook auth
TABBY_WEBHOOK_SECRET=""
# Optional: override API base (defaults to https://api.tabby.ai)
TABBY_API_BASE="https://api.tabby.ai"

# Tamara (Buy Now, Pay Later)
# Merchant API key (token) from Tamara
TAMARA_API_KEY="your_tamara_merchant_key"
# Optional: override API base (defaults to https://api.tamara.co; sandbox uses https://api-staging.tamara.co)
TAMARA_API_BASE="https://api.tamara.co"

# Public base URL of this backend (used to build Tamara IPN notification URLs,
# e.g. https://api.yourdomain.com). Required for Tamara.
BACKEND_PUBLIC_URL="http://localhost:3001"

# Mailtrap
MAILTRAP_TOKEN="your-mailtrap-token"
MAILTRAP_SENDER_EMAIL="hello@capellauae.com"
MAILTRAP_SENDER_NAME="Capella"
MAILTRAP_OWNERS="owner1@example.com,owner2@example.com"

# Meta Conversions API
META_PIXEL_ID="your-pixel-id"
META_ACCESS_TOKEN="your-access-token"
META_TEST_EVENT_CODE=""

# Meta Catalog Feed (scheduled fetch — use a 64-char random hex string)
META_FEED_TOKEN=""
META_FEED_BRAND="Capella"

# Marketing URL (for Ziina redirect URLs)
MARKETING_URL="http://localhost:3000"
