# Database - Use the Internal DB URL from Coolify's PostgreSQL service settings
DATABASE_URL=postgresql://user:password@<coolify-postgres-hostname>:5432/database?schema=public

# Coolify DB network name - find it on your VPS with: docker network ls
# Usually the format is: <project-uuid> (shown in Coolify under the DB service)
COOLIFY_DB_NETWORK=coolify

# JWT Secret - Generate a strong random string
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS Origins - comma-separated list of allowed origins (use * for all in development)
CORS_ORIGIN=*

# Cloudflare R2 (S3-compatible object storage for image/video uploads)
# dev:  R2_PUBLIC_URL=https://cdndev.capellauae.com
# prod: R2_PUBLIC_URL=https://cdn.capellauae.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=capella
R2_PUBLIC_URL=https://cdndev.capellauae.com

# Cloudinary — ONLY needed for the one-off asset migration (scripts/migrate-cloudinary-to-r2.ts).
# Remove once the migration to R2 is complete.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# API URLs - Update these with your domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com

# Site URL (for sitemap and SEO)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Stripe
# For local dev, get these from the Stripe Dashboard (Secret Key) 
# and from the Stripe CLI output when running 'stripe listen' (Webhook Secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tabby (Buy Now, Pay Later)
TABBY_SECRET_KEY=sk_test_...
TABBY_MERCHANT_CODE=CUAE
TABBY_WEBHOOK_SECRET=
TABBY_API_BASE=https://api.tabby.ai

# Tamara (Buy Now, Pay Later)
TAMARA_API_KEY=your-tamara-merchant-key
# Sandbox for local/testing, production for live. Sandbox: https://api-sandbox.tamara.co
TAMARA_API_BASE=https://api-sandbox.tamara.co

# BNPL visibility flags — set to "false" to hide a provider from clients.
# Production: "false" (hidden until ready). Preview deploy (for Tabby/Tamara teams): "true".
TABBY_ENABLED=true
TAMARA_ENABLED=true

# Public base URL of the backend API (used for Tamara IPN notifications)
BACKEND_PUBLIC_URL=https://api.yourdomain.com
